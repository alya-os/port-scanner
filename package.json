{
  "name": "port-scanner",
  "version": "0.1.0",
  "description": "Local-first desktop app that traces open ports to projects, processes, and Docker containers, then helps stop them safely.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alya-os/port-scanner.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:web": "node --test --experimental-strip-types tests/*.test.mjs",
    "test:ui": "vitest run",
    "test": "npm run test:web && npm run test:ui",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
