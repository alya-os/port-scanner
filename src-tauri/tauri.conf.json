{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Port Scanner",
  "version": "0.1.0",
  "identifier": "ai.alya.port-scanner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Port Scanner",
        "width": 1440,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "theme": "Dark",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "ALYA Labs",
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
